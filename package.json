{
  "name": "camouflage-web",
  "private": true,
  "type": "module",
  "description": "Camouflage for web: Web Components in TypeScript and Lit (the third platform next to Kotlin and Flutter).",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm manifest",
    "typecheck": "tsc -b && tsc -p tests --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "layers": "node tools/check-layers.mjs",
    "skins": "node tools/check-skins.mjs",
    "side-effects": "node tools/check-side-effects.mjs",
    "themes": "jiti tools/generate-starter-themes.ts",
    "themes:check": "jiti tools/generate-starter-themes.ts --check",
    "typings": "jiti tools/generate-typings.ts",
    "typings:check": "jiti tools/generate-typings.ts --check",
    "manifest": "jiti tools/write-manifest.ts",
    "size": "node tools/size-budget.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm themes:check && pnpm typings:check && pnpm layers && pnpm skins && pnpm side-effects && pnpm test",
    "storybook": "pnpm --filter @srctool/camouflage-storybook dev",
    "storybook:build": "pnpm --filter @srctool/camouflage-storybook build"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/js": "10.0.1",
    "@lit-labs/ssr": "4.1.0",
    "@lit/context": "1.1.6",
    "@playwright/test": "1.65.1",
    "@srctool/camouflage-core": "workspace:*",
    "@srctool/camouflage-skin-cupertino": "workspace:*",
    "@srctool/camouflage-skin-minimal": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.2.7",
    "@vitest/browser-playwright": "5.1.1",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.14.0",
    "jiti": "2.6.1",
    "lit": "3.3.3",
    "prettier": "3.10.1",
    "rolldown": "1.2.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue": "3.5.27"
  },
  "customElements": "node_modules/.cache/camo-manifest/custom-elements.json"
}
